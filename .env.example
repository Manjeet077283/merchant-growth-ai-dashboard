# ==============================================================================
# Merchant Growth AI — Environment Configuration
# PayPal AI Hackathon 2026
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEMO_MODE=true
PORT=8000
HOST=0.0.0.0

# SQLite Local Database (Default: ./merchant_growth.db)
DATABASE_URL=sqlite:///./merchant_growth.db

# ------------------------------------------------------------------------------
# PayPal REST API Sandbox Credentials
# Get yours from: https://developer.paypal.com > Dashboard > Apps & Credentials > Sandbox
# If left empty, the application runs seamlessly in high-fidelity Sandbox Simulator mode.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Configurable LLM Provider)
# Get your API key from: https://aistudio.google.com
# If left empty, the system uses its built-in Grounded Deterministic AI Engine.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
